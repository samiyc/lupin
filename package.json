{
  "name": "lopin-742",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schotten Totten adapté à un jeu de 52 cartes ou de tarot : statistiques des combinaisons, simulation de parties et règles imprimables.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:coverage": "node --test --experimental-test-coverage tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "build": "node scripts/build.js",
    "build:quick": "node scripts/build.js --quick",
    "pdf": "node scripts/pdf.js",
    "play": "node scripts/play-server.js",
    "duel": "node scripts/duel.js",
    "replays": "node scripts/replays.js",
    "fingerprint": "node scripts/fingerprint.js",
    "duel:long": "node scripts/duel.js --long",
    "luck": "node scripts/luck.js",
    "selfplay": "node scripts/selfplay.js",
    "mine": "node scripts/mine.js",
    "time-study": "node scripts/time-study.js",
    "puzzles": "node scripts/puzzles.js",
    "elo": "node scripts/elo.js",
    "bench": "node scripts/bench.js",
    "puzzles:immediate": "node scripts/immediate-puzzles.js",
    "hiding": "node scripts/hiding.js",
    "policy": "node scripts/policy.js",
    "bretagne": "node scripts/bretagne.js",
    "pivots": "node scripts/pivots.js",
    "games": "node scripts/games.js",
    "branch": "node scripts/branch.js",
    "error-impact": "node scripts/error-impact.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0"
  }
}
